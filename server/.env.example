NODE_ENV=dev
PORT=4000
MONGODB_URI=mongodb://root:changeme@localhost:27017/pickleball?authSource=admin
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=15m
# Refresh tokens are opaque random values stored hashed in Mongo — no secret needed.
REFRESH_EXPIRES_IN=30d
# Path the browser uses for auth routes (Vite proxies /api -> server in dev)
REFRESH_COOKIE_PATH=/api/auth
CORS_ORIGIN=http://localhost:5173
